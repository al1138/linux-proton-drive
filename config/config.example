# =============================================================================
# Advanced template (optional)
# =============================================================================
# Most people should NOT copy this by hand.
# Prefer:  proton-drive-sync setup
#
# If you already ran setup/init, your real file is:
#   ~/.config/proton-drive-sync/config
# =============================================================================

# Path to the official Proton Drive CLI
PROTON_DRIVE_BIN="__HOME__/.local/bin/proton-drive"

# Where the login session is stored: keychain (recommended) or pass
# unsafe_file is refused by proton-drive-sync
CREDENTIALS_STORE="keychain"

SKIP_THUMBNAILS=1

# Upload behaviour (backup)
PUSH_FILE_CONFLICT="create-new-revision"
PUSH_FOLDER_CONFLICT="merge"

# Download behaviour (keep local files safe)
PULL_FILE_CONFLICT="skip"
PULL_FOLDER_CONFLICT="merge"

# Keep at 0 unless you knowingly accept overwriting local files on pull
ALLOW_DELETE=0

# Folder pairs:
# PAIR_<name>="<pc_folder>|<proton_drive_folder>|<push|pull|both>"
PAIR_documents="__HOME__/Documents|/my-files/Linux/Documents|push"
PAIR_pictures="__HOME__/Pictures|/my-files/Linux/Pictures|push"
