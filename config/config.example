# proton-drive-sync configuration
# Installed copy: ~/.config/proton-drive-sync/config  (chmod 600)
# Docs: https://proton.me/support/drive-cli
#
# Tokens of the form shown in paths below are replaced with $HOME by
# `proton-drive-sync init`. Do not commit your generated config file.

# Official CLI binary (full path recommended after install-cli.sh)
PROTON_DRIVE_BIN="__HOME__/.local/bin/proton-drive"

# Session storage: keychain (libsecret / GNOME Keyring) or pass
# Never use unsafe_file — refused by proton-drive-sync
CREDENTIALS_STORE="keychain"

# Safer, quieter uploads (thumbnails optional)
SKIP_THUMBNAILS=1

# Push (local → Drive): keep Drive revision history
PUSH_FILE_CONFLICT="create-new-revision"
PUSH_FOLDER_CONFLICT="merge"

# Pull (Drive → local): never overwrite local files by default
PULL_FILE_CONFLICT="skip"
PULL_FOLDER_CONFLICT="merge"

# Set to 1 only if you accept overwriting local files on pull conflicts
ALLOW_DELETE=0

# ---------------------------------------------------------------------------
# Folder pairs (one per line)
# Format: PAIR_<name>=<local_absolute_path>|<remote_drive_path>|<mode>
# mode: push | pull | both
#
# Security note: default to "push" (backup). The official CLI does NOT
# delete remote files when local files disappear — that is intentional
# and safer against ransomware / accidental rm.
# ---------------------------------------------------------------------------

PAIR_documents="__HOME__/Documents|/my-files/Linux/Documents|push"
PAIR_pictures="__HOME__/Pictures|/my-files/Linux/Pictures|push"

# Example pull-only (new remote files appear locally; existing local kept):
# PAIR_shared="__HOME__/ProtonShared|/my-files/Shared|pull"

# Example both ways (push revisions first, then pull with skip):
# PAIR_notes="__HOME__/Notes|/my-files/Linux/Notes|both"
