[Unit]
Description=Schedule Proton Drive sync (startup + every 5 minutes)
Documentation=https://proton.me/support/drive-cli

[Timer]
# Shortly after login/boot, then every 5 minutes after the last run finishes.
OnBootSec=1min
OnUnitActiveSec=5min
Persistent=true
RandomizedDelaySec=15
Unit=proton-drive-sync.service

[Install]
WantedBy=timers.target
