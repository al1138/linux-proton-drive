#!/usr/bin/env bash
# Thin, safety-first scheduler around the official Proton Drive CLI.
# Not a real-time sync engine — intentional: atomic runs, no live session daemon.
set -euo pipefail

readonly APP_NAME="proton-drive-sync"
readonly VERSION="1.0.0"

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"

CONFIG_DIR="${PROTON_DRIVE_SYNC_CONFIG_DIR:-$XDG_CONFIG_HOME/$APP_NAME}"
STATE_DIR="${PROTON_DRIVE_SYNC_STATE_DIR:-$XDG_STATE_HOME/$APP_NAME}"
CONFIG_FILE="${PROTON_DRIVE_SYNC_CONFIG:-$CONFIG_DIR/config}"
LOCK_FILE="$STATE_DIR/sync.lock"
LOG_DIR="$STATE_DIR/logs"

# Defaults (overridable in config)
PROTON_DRIVE_BIN="${PROTON_DRIVE_BIN:-proton-drive}"
CREDENTIALS_STORE="${CREDENTIALS_STORE:-keychain}"
SKIP_THUMBNAILS="${SKIP_THUMBNAILS:-1}"
PUSH_FILE_CONFLICT="${PUSH_FILE_CONFLICT:-create-new-revision}"
PUSH_FOLDER_CONFLICT="${PUSH_FOLDER_CONFLICT:-merge}"
PULL_FILE_CONFLICT="${PULL_FILE_CONFLICT:-skip}"
PULL_FOLDER_CONFLICT="${PULL_FOLDER_CONFLICT:-merge}"
ALLOW_DELETE="${ALLOW_DELETE:-0}"
DRY_RUN="${DRY_RUN:-0}"
VERBOSE="${VERBOSE:-0}"

declare -a PAIR_NAMES=()
declare -A PAIR_LOCAL=()
declare -A PAIR_REMOTE=()
declare -A PAIR_MODE=()

usage() {
  cat <<EOF
$APP_NAME $VERSION — sync folders via official proton-drive CLI

Usage:
  $APP_NAME <command> [options] [pair...]

Commands:
  setup             Guided setup (recommended): choose folders, write config
  init              Create a ready-to-use config automatically (no questions)
  login             Sign in via browser (session stored in the system keyring)
  logout            Sign out
  status            Show settings and folder list
  push [pair...]    Upload local folders → Proton Drive
  pull [pair...]    Download Proton Drive → local folders
  sync [pair...]    Run each folder pair (push / pull / both)
  doctor            Check that everything is ready

Options:
  -c, --config PATH   Config file (default: $CONFIG_FILE)
  -n, --dry-run       Print planned CLI commands only
  -v, --verbose       Pass --verbose to proton-drive
  -h, --help          Show help

Environment:
  PROTON_DRIVE_BIN              Path to proton-drive binary
  PROTON_DRIVE_CREDENTIALS_STORE  keychain | pass  (unsafe_file refused)
  PROTON_DRIVE_SYNC_CONFIG      Override config path

Security defaults:
  • No remote/local deletes unless ALLOW_DELETE=1 in config
  • Push uses create-new-revision (keeps Drive history)
  • Pull uses file conflict skip (never overwrite local silently)
  • Concurrent runs blocked with flock
EOF
}

die() { echo "error: $*" >&2; exit 1; }
log() { printf '%s %s\n' "$(date -Iseconds)" "$*" >&2; }
info() { log "INFO  $*"; }
warn() { log "WARN  $*"; }

ensure_dirs() {
  mkdir -p "$CONFIG_DIR" "$STATE_DIR" "$LOG_DIR"
  chmod 700 "$CONFIG_DIR" "$STATE_DIR" 2>/dev/null || true
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

unquote() {
  local v="$1"
  if [[ "$v" =~ ^\"(.*)\"$ ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  elif [[ "$v" =~ ^\'(.*)\'$ ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  else
    printf '%s' "$v"
  fi
}

set_known_config() {
  local key="$1" val="$2"
  case "$key" in
    PROTON_DRIVE_BIN) PROTON_DRIVE_BIN="$val" ;;
    CREDENTIALS_STORE) CREDENTIALS_STORE="$val" ;;
    SKIP_THUMBNAILS) SKIP_THUMBNAILS="$val" ;;
    PUSH_FILE_CONFLICT) PUSH_FILE_CONFLICT="$val" ;;
    PUSH_FOLDER_CONFLICT) PUSH_FOLDER_CONFLICT="$val" ;;
    PULL_FILE_CONFLICT) PULL_FILE_CONFLICT="$val" ;;
    PULL_FOLDER_CONFLICT) PULL_FOLDER_CONFLICT="$val" ;;
    PULL_FILE_CONFLICT_ALLOW_DELETE) PULL_FILE_CONFLICT_ALLOW_DELETE="$val" ;;
    PULL_FOLDER_CONFLICT_ALLOW_DELETE) PULL_FOLDER_CONFLICT_ALLOW_DELETE="$val" ;;
    ALLOW_DELETE) ALLOW_DELETE="$val" ;;
    VERBOSE) VERBOSE="$val" ;;
    *) die "unknown config key: $key (refusing to parse arbitrary assignments)" ;;
  esac
}

load_config() {
  [[ -f "$CONFIG_FILE" ]] || die "config not found: $CONFIG_FILE (run: $APP_NAME init)"

  local perms
  perms=$(stat -c '%a' "$CONFIG_FILE" 2>/dev/null || stat -f '%OLp' "$CONFIG_FILE")
  if [[ "$perms" != "600" && "$perms" != "400" ]]; then
    warn "config permissions are $perms; recommend chmod 600 $CONFIG_FILE"
  fi

  PAIR_NAMES=()
  PAIR_LOCAL=()
  PAIR_REMOTE=()
  PAIR_MODE=()

  local line key val name rest local_path remote_path pair_mode
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" || "$line" == \#* ]] && continue

    if [[ "$line" =~ ^PAIR_([A-Za-z0-9_-]+)=(.*)$ ]]; then
      name="${BASH_REMATCH[1]}"
      rest="$(unquote "${BASH_REMATCH[2]}")"
      IFS='|' read -r local_path remote_path pair_mode <<<"$rest"
      [[ -n "${local_path:-}" && -n "${remote_path:-}" ]] || die "bad PAIR_$name value"
      pair_mode="${pair_mode:-push}"
      case "$pair_mode" in
        push|pull|both) ;;
        *) die "PAIR_$name: invalid mode '$pair_mode' (push|pull|both)" ;;
      esac
      [[ "$remote_path" == /* ]] || die "PAIR_$name: remote path must be absolute in Drive (start with /)"
      [[ "$local_path" == /* ]] || die "PAIR_$name: local path must be absolute"
      PAIR_NAMES+=("$name")
      PAIR_LOCAL["$name"]="$local_path"
      PAIR_REMOTE["$name"]="$remote_path"
      PAIR_MODE["$name"]="$pair_mode"
      continue
    fi

    if [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
      key="${BASH_REMATCH[1]}"
      val="$(unquote "${BASH_REMATCH[2]}")"
      set_known_config "$key" "$val"
      continue
    fi

    die "invalid config line: $line"
  done <"$CONFIG_FILE"

  case "${CREDENTIALS_STORE}" in
    keychain|pass) ;;
    unsafe_file)
      die "CREDENTIALS_STORE=unsafe_file is refused (stores session in plaintext)"
      ;;
    *)
      die "invalid CREDENTIALS_STORE='$CREDENTIALS_STORE' (use keychain or pass)"
      ;;
  esac
  export PROTON_DRIVE_CREDENTIALS_STORE="$CREDENTIALS_STORE"

  [[ ${#PAIR_NAMES[@]} -gt 0 ]] || die "no PAIR_* entries in $CONFIG_FILE"
}

resolve_bin() {
  if [[ "$PROTON_DRIVE_BIN" == /* ]]; then
    [[ -x "$PROTON_DRIVE_BIN" ]] || die "PROTON_DRIVE_BIN not executable: $PROTON_DRIVE_BIN"
    echo "$PROTON_DRIVE_BIN"
    return
  fi
  command -v "$PROTON_DRIVE_BIN" || die "proton-drive not found in PATH (run scripts/install-cli.sh)"
}

pd() {
  local bin
  bin=$(resolve_bin)
  local -a args=("$bin")
  [[ "$VERBOSE" == "1" ]] && args+=(--verbose)
  args+=("$@")
  if [[ "$DRY_RUN" == "1" ]]; then
    printf 'DRY-RUN:'
    printf ' %q' "${args[@]}"
    printf '\n'
    return 0
  fi
  "${args[@]}"
}

with_lock() {
  ensure_dirs
  if command -v flock >/dev/null 2>&1; then
    exec 9>"$LOCK_FILE"
    if ! flock -n 9; then
      die "another $APP_NAME run holds $LOCK_FILE"
    fi
    "$@"
    return
  fi

  # Fallback for platforms without util-linux flock (dev hosts).
  LOCK_DIR="${LOCK_FILE}.d"
  if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    die "another $APP_NAME run holds $LOCK_DIR"
  fi
  # shellcheck disable=SC2064
  trap 'rmdir "${LOCK_DIR:-}" 2>/dev/null || true' EXIT
  "$@"
  rmdir "$LOCK_DIR" 2>/dev/null || true
  trap - EXIT
}

use_french() {
  case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in
    fr|fr_*|fr.*) return 0 ;;
    *) return 1 ;;
  esac
}

say() {
  # Plain messages for humans (no timestamp) — used by setup/init.
  printf '%s\n' "$*"
}

find_cli_bin() {
  if [[ -n "${PROTON_DRIVE_BIN:-}" && "$PROTON_DRIVE_BIN" == /* && -x "$PROTON_DRIVE_BIN" ]]; then
    printf '%s' "$PROTON_DRIVE_BIN"
    return
  fi
  if [[ -x "$HOME/.local/bin/proton-drive" ]]; then
    printf '%s' "$HOME/.local/bin/proton-drive"
    return
  fi
  if command -v proton-drive >/dev/null 2>&1; then
    command -v proton-drive
    return
  fi
  printf '%s' "$HOME/.local/bin/proton-drive"
}

# Args: name local_path remote_path mode  (repeatable groups written by caller into arrays)
write_simple_config() {
  local bin="$1"
  shift
  # Remaining: triples name|local|remote|mode via parallel arrays passed as lines "name|local|remote|mode"
  local -a lines=("$@")
  local line name local_path remote_path mode

  ensure_dirs
  {
    cat <<EOF
# =============================================================================
# Proton Drive — dossiers sauvegardés depuis cet ordinateur
# =============================================================================
#
# Ce fichier a été créé pour vous. En général vous n'avez RIEN à modifier.
#
# Chaque ligne qui commence par PAIR_ décrit UN dossier :
#   PAIR_nom="dossier_sur_le_PC|dossier_dans_Proton_Drive|push"
#
#   push = envoyer une copie vers Proton Drive (sauvegarde, recommandé)
#   pull = télécharger depuis Proton Drive vers le PC
#   both = les deux (d'abord envoi, puis réception)
#
# Les fichiers effacés sur le PC ne sont PAS effacés sur Proton Drive
# (sécurité : une fausse manip ou un virus ne vide pas le cloud).
#
# Emplacement de ce fichier : $CONFIG_FILE
# =============================================================================

PROTON_DRIVE_BIN="$bin"
CREDENTIALS_STORE="keychain"
ALLOW_DELETE=0
SKIP_THUMBNAILS=1

EOF
    for line in "${lines[@]}"; do
      IFS='|' read -r name local_path remote_path mode <<<"$line"
      printf '# %s\n' "$local_path  →  $remote_path  ($mode)"
      printf 'PAIR_%s="%s|%s|%s"\n\n' "$name" "$local_path" "$remote_path" "$mode"
    done
  } >"$CONFIG_FILE"
  chmod 600 "$CONFIG_FILE"
}

default_folder_candidates() {
  # Prints: id|Label|local_path|remote_path
  local d
  for d in Documents Documenten Documenti; do
    [[ -d "$HOME/$d" ]] && echo "documents|Documents|$HOME/$d|/my-files/Linux/Documents" && break
  done
  for d in Pictures Photos Images Bilder; do
    [[ -d "$HOME/$d" ]] && echo "pictures|Pictures / Photos|$HOME/$d|/my-files/Linux/Pictures" && break
  done
  for d in Desktop Bureau Schreibtisch; do
    [[ -d "$HOME/$d" ]] && echo "desktop|Desktop / Bureau|$HOME/$d|/my-files/Linux/Desktop" && break
  done
  for d in Downloads Téléchargements; do
    [[ -d "$HOME/$d" ]] && echo "downloads|Downloads / Téléchargements|$HOME/$d|/my-files/Linux/Downloads" && break
  done
}

ask_yn() {
  # Always read from the terminal — never from a redirected stdin
  # (e.g. a `while read` loop over folder candidates would steal answers).
  local prompt="$1" reply
  if use_french; then
    printf '%s [O/n] ' "$prompt" >/dev/tty
  else
    printf '%s [Y/n] ' "$prompt" >/dev/tty
  fi
  if [[ -r /dev/tty ]]; then
    read -r reply </dev/tty || true
  else
    read -r reply || true
  fi
  printf '\n' >/dev/tty 2>/dev/null || true
  reply="${reply:-Y}"
  case "$reply" in
    O|o|Oui|oui|Y|y|yes|YES) return 0 ;;
    *) return 1 ;;
  esac
}

read_custom_path() {
  local prompt="$1" value
  printf '%s' "$prompt" >/dev/tty
  if [[ -r /dev/tty ]]; then
    read -r value </dev/tty || true
  else
    read -r value || true
  fi
  printf '\n' >/dev/tty 2>/dev/null || true
  printf '%s' "$value"
}

cmd_init() {
  ensure_dirs
  if [[ -f "$CONFIG_FILE" ]]; then
    if use_french; then
      say "Une configuration existe déjà : $CONFIG_FILE"
      say "Pour la refaire avec l'assistant : proton-drive-sync setup"
    else
      say "Config already exists: $CONFIG_FILE"
      say "To recreate it with the assistant: proton-drive-sync setup"
    fi
    return 0
  fi

  local bin candidate id label local_path remote_path
  local -a pairs=()
  bin=$(find_cli_bin)

  local -a candidates=()
  local entry
  mapfile -t candidates < <(default_folder_candidates)
  for entry in "${candidates[@]}"; do
    [[ -n "$entry" ]] || continue
    IFS='|' read -r id label local_path remote_path <<<"$entry"
    # Auto-include Documents + Pictures only (safe defaults); others via setup
    case "$id" in
      documents|pictures) pairs+=("${id}|${local_path}|${remote_path}|push") ;;
    esac
  done

  if [[ ${#pairs[@]} -eq 0 ]]; then
    mkdir -p "$HOME/Documents"
    pairs+=("documents|$HOME/Documents|/my-files/Linux/Documents|push")
  fi

  write_simple_config "$bin" "${pairs[@]}"

  if use_french; then
    say ""
    say "Configuration créée automatiquement :"
    say "  $CONFIG_FILE"
    say ""
    say "Dossiers qui seront sauvegardés sur Proton Drive :"
    local p
    for p in "${pairs[@]}"; do
      IFS='|' read -r id local_path remote_path _ <<<"$p"
      say "  • $local_path"
    done
    say ""
    say "Étapes suivantes :"
    say "  1) proton-drive-sync login     (connexion dans le navigateur)"
    say "  2) proton-drive-sync doctor    (vérification)"
    say "  3) proton-drive-sync sync      (lancer la sauvegarde)"
    say ""
    say "Pour choisir d'autres dossiers : proton-drive-sync setup"
  else
    say ""
    say "Config created automatically:"
    say "  $CONFIG_FILE"
    say ""
    say "Folders that will be backed up to Proton Drive:"
    local p
    for p in "${pairs[@]}"; do
      IFS='|' read -r id local_path remote_path _ <<<"$p"
      say "  • $local_path"
    done
    say ""
    say "Next steps:"
    say "  1) proton-drive-sync login"
    say "  2) proton-drive-sync doctor"
    say "  3) proton-drive-sync sync"
    say ""
    say "To choose different folders: proton-drive-sync setup"
  fi
}

cmd_setup() {
  ensure_dirs
  local bin id label local_path remote_path custom_local custom_name
  local -a pairs=()

  bin=$(find_cli_bin)

  if [[ -f "$CONFIG_FILE" ]]; then
    if use_french; then
      ask_yn "Une config existe déjà. La remplacer ?" || {
        say "OK, fichier inchangé : $CONFIG_FILE"
        return 0
      }
    else
      ask_yn "A config already exists. Replace it?" || {
        say "OK, left unchanged: $CONFIG_FILE"
        return 0
      }
    fi
  fi

  if use_french; then
    say ""
    say "=============================================="
    say "  Assistant Proton Drive (sauvegarde simple)"
    say "=============================================="
    say ""
    say "On va choisir quels dossiers de VOTRE ordinateur"
    say "seront copiés vers Proton Drive (cloud sécurisé)."
    say "Répondez par O (oui) ou n (non)."
    say ""
  else
    say ""
    say "=============================================="
    say "  Proton Drive setup (simple backup)"
    say "=============================================="
    say ""
    say "We will choose which folders on THIS computer"
    say "are copied to Proton Drive (encrypted cloud)."
    say "Answer Y (yes) or n (no)."
    say ""
  fi

  local -a candidates=()
  local entry
  mapfile -t candidates < <(default_folder_candidates)
  for entry in "${candidates[@]}"; do
    [[ -n "$entry" ]] || continue
    IFS='|' read -r id label local_path remote_path <<<"$entry"
    if use_french; then
      ask_yn "Sauvegarder « $label » ?" && pairs+=("${id}|${local_path}|${remote_path}|push")
    else
      ask_yn "Back up « $label »?" && pairs+=("${id}|${local_path}|${remote_path}|push")
    fi
  done

  if use_french; then
    if ask_yn "Ajouter un autre dossier (chemin personnalisé) ?"; then
      custom_local=$(read_custom_path "Chemin complet du dossier (ex. $HOME/Projets) : ")
      custom_local="${custom_local/#\~/$HOME}"
      [[ -d "$custom_local" ]] || die "ce dossier n'existe pas : $custom_local"
      custom_name=$(basename "$custom_local" | tr -c 'A-Za-z0-9_-' '_' | tr '[:upper:]' '[:lower:]')
      [[ -n "$custom_name" ]] || custom_name="custom"
      pairs+=("${custom_name}|${custom_local}|/my-files/Linux/${custom_name}|push")
    fi
  else
    if ask_yn "Add another folder (custom path)?"; then
      custom_local=$(read_custom_path "Full folder path (e.g. $HOME/Projects): ")
      custom_local="${custom_local/#\~/$HOME}"
      [[ -d "$custom_local" ]] || die "folder does not exist: $custom_local"
      custom_name=$(basename "$custom_local" | tr -c 'A-Za-z0-9_-' '_' | tr '[:upper:]' '[:lower:]')
      [[ -n "$custom_name" ]] || custom_name="custom"
      pairs+=("${custom_name}|${custom_local}|/my-files/Linux/${custom_name}|push")
    fi
  fi

  if [[ ${#pairs[@]} -eq 0 ]]; then
    if use_french; then
      say "Aucun dossier choisi — création d'une sauvegarde Documents par défaut."
    else
      say "No folder selected — creating a default Documents backup."
    fi
    mkdir -p "$HOME/Documents"
    pairs+=("documents|$HOME/Documents|/my-files/Linux/Documents|push")
  fi

  write_simple_config "$bin" "${pairs[@]}"

  if use_french; then
    say ""
    say "C'est prêt. Fichier enregistré :"
    say "  $CONFIG_FILE"
    say ""
    say "Dossiers retenus :"
    local p
    for p in "${pairs[@]}"; do
      IFS='|' read -r id local_path remote_path _ <<<"$p"
      say "  • $local_path"
    done
    say ""
    say "Faites maintenant, dans l'ordre :"
    say "  1) proton-drive-sync login"
    say "       → une page s'ouvre dans le navigateur pour vous connecter"
    say "  2) proton-drive-sync sync"
    say "       → envoie vos dossiers vers Proton Drive"
    say ""
    say "Astuce : proton-drive-sync --dry-run sync"
    say "       montre ce qui serait envoyé, sans rien copier."
  else
    say ""
    say "Done. Config saved to:"
    say "  $CONFIG_FILE"
    say ""
    say "Selected folders:"
    local p
    for p in "${pairs[@]}"; do
      IFS='|' read -r id local_path remote_path _ <<<"$p"
      say "  • $local_path"
    done
    say ""
    say "Next, run these in order:"
    say "  1) proton-drive-sync login"
    say "       → a browser window opens so you can sign in"
    say "  2) proton-drive-sync sync"
    say "       → uploads your folders to Proton Drive"
    say ""
    say "Tip: proton-drive-sync --dry-run sync"
    say "     shows what would be uploaded, without copying anything."
  fi
}

cmd_login() {
  load_config
  info "opening browser login via official CLI…"
  pd auth login
}

cmd_logout() {
  load_config
  pd auth logout
}

auth_ok() {
  # list root areas; fails if not logged in
  pd filesystem list / --json >/dev/null 2>&1
}

cmd_doctor() {
  load_config
  local bin ok=0
  bin=$(resolve_bin)
  info "binary: $bin"
  if [[ "$DRY_RUN" == "1" ]]; then
    info "dry-run: skip version/auth probes"
    return 0
  fi
  pd version || die "proton-drive version failed"
  case "$CREDENTIALS_STORE" in
    keychain)
      if command -v secret-tool >/dev/null 2>&1; then
        info "libsecret tooling present (secret-tool)"
      else
        warn "secret-tool not found — install libsecret-tools (Mint: apt install libsecret-tools)"
      fi
      ;;
    pass)
      command -v pass >/dev/null 2>&1 || die "pass not installed but CREDENTIALS_STORE=pass"
      ;;
  esac
  if auth_ok; then
    info "auth: OK"
  else
    warn "auth: not logged in (run: $APP_NAME login)"
    ok=1
  fi
  local name
  for name in "${PAIR_NAMES[@]}"; do
    local lp="${PAIR_LOCAL[$name]}"
    if [[ -d "$lp" ]]; then
      info "pair $name local OK: $lp → ${PAIR_REMOTE[$name]} (${PAIR_MODE[$name]})"
    else
      warn "pair $name local missing: $lp"
      ok=1
    fi
  done
  return "$ok"
}

cmd_status() {
  load_config
  echo "config:  $CONFIG_FILE"
  echo "binary:  $(resolve_bin)"
  echo "creds:   $CREDENTIALS_STORE"
  echo "allow_delete: $ALLOW_DELETE"
  echo "pairs:"
  local name
  for name in "${PAIR_NAMES[@]}"; do
    printf '  %-16s %-5s  %s  ↔  %s\n' \
      "$name" "${PAIR_MODE[$name]}" "${PAIR_LOCAL[$name]}" "${PAIR_REMOTE[$name]}"
  done
  echo "recent logs:"
  ls -1t "$LOG_DIR"/*.log 2>/dev/null | head -5 || echo "  (none)"
  if [[ "$DRY_RUN" != "1" ]]; then
    if auth_ok; then echo "auth: OK"; else echo "auth: NOT LOGGED IN"; fi
  fi
}

run_log_path() {
  local action="$1" name="$2"
  printf '%s/%s-%s-%s.log' "$LOG_DIR" "$(date +%Y%m%d-%H%M%S)" "$action" "$name"
}

remote_exists() {
  # Quiet existence check (folder or file) on Proton Drive.
  # In dry-run, pretend missing so create-folder commands are shown.
  [[ "$DRY_RUN" == "1" ]] && return 1
  pd filesystem list --json "$1" >/dev/null 2>&1
}

ensure_remote_dirs() {
  # Create each missing segment of an absolute Drive path.
  # Example: /my-files/Linux → create "Linux" under /my-files.
  # Official CLI: filesystem create-folder <parentPath> <name>
  # Without this, upload fails with: Node not found : Linux
  local path="$1"
  [[ "$path" == /* ]] || { warn "remote path must be absolute: $path"; return 1; }

  local accum="" part next
  local -a parts=()
  IFS='/' read -ra parts <<<"$path"
  for part in "${parts[@]}"; do
    [[ -z "$part" ]] && continue
    if [[ -z "$accum" ]]; then
      accum="/$part"
      continue
    fi
    next="$accum/$part"
    if remote_exists "$next"; then
      accum="$next"
      continue
    fi
    info "creating remote folder: $next"
    if [[ "$DRY_RUN" == "1" ]]; then
      pd filesystem create-folder --json "$accum" "$part"
      accum="$next"
      continue
    fi
    # Ignore "already exists" races; fail only if still missing afterwards.
    pd filesystem create-folder --json "$accum" "$part" >/dev/null 2>&1 || true
    if ! remote_exists "$next"; then
      if ! pd filesystem create-folder "$accum" "$part"; then
        warn "cannot create remote folder $next (parent: $accum)"
        return 1
      fi
    fi
    accum="$next"
  done
  return 0
}

upload_parent_for() {
  # CLI signature: upload <local...> <parentPath>
  # For local .../Documents → remote .../Linux/Documents, upload into .../Linux
  # so the folder name matches. Otherwise upload into the full remote folder.
  local local_path="$1" remote_path="$2"
  if [[ "$(basename "$local_path")" == "$(basename "$remote_path")" ]]; then
    dirname "$remote_path"
  else
    printf '%s' "$remote_path"
  fi
}

push_pair() {
  local name="$1"
  local local_path="${PAIR_LOCAL[$name]}"
  local remote_path="${PAIR_REMOTE[$name]}"
  [[ -d "$local_path" ]] || die "pair $name: local directory missing: $local_path"

  local logfile upload_parent
  logfile=$(run_log_path push "$name")
  upload_parent=$(upload_parent_for "$local_path" "$remote_path")

  info "push [$name] $local_path → $remote_path"
  # Parents must exist ("Node not found : Linux" = missing /my-files/Linux).
  if ! ensure_remote_dirs "$upload_parent"; then
    warn "push aborted for $name: could not prepare remote parent $upload_parent"
    return 1
  fi
  if [[ "$upload_parent" == "$remote_path" ]]; then
    if ! ensure_remote_dirs "$remote_path"; then
      warn "push aborted for $name: could not prepare remote folder $remote_path"
      return 1
    fi
  fi

  local -a args=(
    filesystem upload
    --json
    --file-conflict-strategy "$PUSH_FILE_CONFLICT"
    --folder-conflict-strategy "$PUSH_FOLDER_CONFLICT"
  )
  [[ "$SKIP_THUMBNAILS" == "1" ]] && args+=(--skip-thumbnails)
  args+=("$local_path" "$upload_parent")

  if [[ "$DRY_RUN" == "1" ]]; then
    pd "${args[@]}"
    return 0
  fi

  if ! pd "${args[@]}" >"$logfile" 2>&1; then
    warn "push failed for $name — see $logfile"
    if grep -qi 'Node not found' "$logfile" 2>/dev/null; then
      warn "hint: a parent folder is missing on Proton Drive; sync now tries to create them automatically — re-run after updating the script"
    fi
    # Show the useful CLI line without dumping secrets
    grep -iE 'Node not found|error|Error' "$logfile" 2>/dev/null | tail -5 | while IFS= read -r line; do
      warn "cli: $line"
    done || true
    return 1
  fi
  info "push [$name] OK → $logfile"
}

pull_pair() {
  local name="$1"
  local local_path="${PAIR_LOCAL[$name]}"
  local remote_path="${PAIR_REMOTE[$name]}"
  mkdir -p "$local_path"

  local file_strategy="$PULL_FILE_CONFLICT"
  local folder_strategy="$PULL_FOLDER_CONFLICT"
  if [[ "$ALLOW_DELETE" == "1" ]]; then
    # Still prefer remove-on-conflict over silent wipe of whole trees.
    file_strategy="${PULL_FILE_CONFLICT_ALLOW_DELETE:-remove}"
    folder_strategy="${PULL_FOLDER_CONFLICT_ALLOW_DELETE:-merge}"
  fi

  local logfile
  logfile=$(run_log_path pull "$name")
  info "pull [$name] $remote_path → $local_path (file=$file_strategy)"

  local -a args=(
    filesystem download
    --json
    --file-conflict-strategy "$file_strategy"
    --folder-conflict-strategy "$folder_strategy"
    "$remote_path"
    "$local_path"
  )

  if [[ "$DRY_RUN" == "1" ]]; then
    pd "${args[@]}"
    return 0
  fi

  if ! pd "${args[@]}" >"$logfile" 2>&1; then
    warn "pull failed for $name — see $logfile"
    return 1
  fi
  info "pull [$name] OK → $logfile"
}

select_pairs() {
  local -a wanted=("$@")
  if [[ ${#wanted[@]} -eq 0 ]]; then
    printf '%s\n' "${PAIR_NAMES[@]}"
    return
  fi
  local w
  for w in "${wanted[@]}"; do
    [[ -n "${PAIR_LOCAL[$w]+x}" ]] || die "unknown pair: $w"
    printf '%s\n' "$w"
  done
}

cmd_push() {
  load_config
  local name rc=0
  while IFS= read -r name; do
    push_pair "$name" || rc=1
  done < <(select_pairs "$@")
  return "$rc"
}

cmd_pull() {
  load_config
  if [[ "$ALLOW_DELETE" != "1" && "$PULL_FILE_CONFLICT" == "remove" ]]; then
    die "PULL_FILE_CONFLICT=remove requires ALLOW_DELETE=1"
  fi
  local name rc=0
  while IFS= read -r name; do
    pull_pair "$name" || rc=1
  done < <(select_pairs "$@")
  return "$rc"
}

cmd_sync() {
  load_config
  local name rc=0 mode
  while IFS= read -r name; do
    mode="${PAIR_MODE[$name]}"
    case "$mode" in
      push) push_pair "$name" || rc=1 ;;
      pull) pull_pair "$name" || rc=1 ;;
      both)
        # Push first so local edits are preserved as Drive revisions,
        # then pull with skip so remote-only files appear without clobbering local.
        push_pair "$name" || rc=1
        pull_pair "$name" || rc=1
        ;;
    esac
  done < <(select_pairs "$@")
  return "$rc"
}

main() {
  local cmd=""
  local -a rest=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage; exit 0 ;;
      -c|--config)
        CONFIG_FILE="${2:?}"
        CONFIG_DIR="$(dirname "$CONFIG_FILE")"
        shift 2
        ;;
      -n|--dry-run) DRY_RUN=1; shift ;;
      -v|--verbose) VERBOSE=1; shift ;;
      -*)
        die "unknown option: $1"
        ;;
      *)
        if [[ -z "$cmd" ]]; then
          cmd="$1"
        else
          rest+=("$1")
        fi
        shift
        ;;
    esac
  done

  [[ -n "$cmd" ]] || { usage; exit 1; }

  case "$cmd" in
    setup) cmd_setup ;;
    init) cmd_init ;;
    login) cmd_login ;;
    logout) cmd_logout ;;
    status) cmd_status ;;
    doctor) cmd_doctor ;;
    push) with_lock cmd_push "${rest[@]+"${rest[@]}"}" ;;
    pull) with_lock cmd_pull "${rest[@]+"${rest[@]}"}" ;;
    sync) with_lock cmd_sync "${rest[@]+"${rest[@]}"}" ;;
    *) die "unknown command: $cmd" ;;
  esac
}

main "$@"
